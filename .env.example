# Environment variables of fp-go-harness.
#
# Copy this file to .env (git-ignored) and fill in the values. Variables that
# are already set in the process environment take precedence over .env.
# The CLI reads .env from the working directory; tests read the .env in the
# repository root.

# API key for DeepSeek's OpenAI-compatible API. Required by the CLI
# and by the live test in openai/deepseek_test.go, which is skipped without it.
DEEPSEEK_API_KEY=

# Configuration of the CLI, each also a flag (MAX_ITERATIONS is
# --max-iterations). Flags take precedence over the environment. Optional.
#
# agent (all tools), plan or ask (read-only tools, the default).
# MODE=ask
# The directory the tools work in, defaults to the working directory.
# WORKSPACE=.
# Chat completion requests per prompt, defaults to 25.
# MAX_ITERATIONS=25
# Bytes of a tool result sent to the model, defaults to 50000.
# MAX_TOOL_OUTPUT=50000

# Directory with the recorded session logs (*.log, JSON lines) that PLAN.md
# was derived from. Tests that replay the recordings are skipped without it.
REPLAY_RECORDINGS_DIR=

# Comma-separated names and handles of the people in the recordings, longer
# terms first. Redaction replaces them; the redaction test checks that none
# survives. Optional.
REPLAY_REDACT_TERMS=
